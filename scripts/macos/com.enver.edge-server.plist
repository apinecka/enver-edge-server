<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.enver.edge-server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/enver/edge-server/node/bin/node</string>
		<string>--env-file-if-exists=/etc/enver/edge-server.env</string>
		<string>/opt/enver/edge-server/@ENTRYPOINT@</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/opt/enver/edge-server</string>
	<key>UserName</key>
	<string>@RUN_USER@</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>/var/log/enver-edge-server.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/enver-edge-server.log</string>
</dict>
</plist>
